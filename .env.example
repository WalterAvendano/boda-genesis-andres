# Configuración de los novios y el evento
COUPLE_NAMES=Ana & Carlos
EVENT_DATE=15 de Noviembre, 2026
WELCOME_MESSAGE=Gracias por acompañarnos en este día tan especial. Sube aquí tus fotos y videos para que podamos revivir cada momento juntos.

# ID de la carpeta en Google Drive donde caerán las fotos/videos
# (Es la cadena larga al final de la URL de tu carpeta en Drive: https://drive.google.com/drive/folders/ESTE_ES_EL_ID)
DRIVE_FOLDER_ID=

# Ruta al archivo de credenciales de Service Account de Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# (Opcional, para Vercel o Render) Pega aquí el contenido JSON completo de service_account.json como una sola línea:
# GOOGLE_SERVICE_ACCOUNT_JSON=
